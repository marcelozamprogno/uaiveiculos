    <div id="root"></div>
  <script>
  (function(){
    var lead={phone:"",name:"",email:"",cpf:""};
    var obs=new MutationObserver(function(){
      var form=document.querySelector("form");
      if(!form)return;
      var inputs=form.querySelectorAll("input:not([type=hidden])");
      inputs.forEach(function(inp){
        if(inp.name==="phone"||inp.id==="phone"||inp.type==="tel"){
          inp.addEventListener("input",function(){lead.phone=inp.value;syncHidden(form);});
          inp.addEventListener("blur",function(){lead.phone=inp.value;syncHidden(form);});
          if(inp.value)lead.phone=inp.value;
        }
        if(inp.name==="name"||inp.id==="name"){
          inp.addEventListener("input",function(){lead.name=inp.value;lead.email=inp.value.replace(/[^a-z0-9]/gi,"")+"@cliente.com";syncHidden(form);});
          inp.addEventListener("blur",function(){lead.name=inp.value;lead.email=inp.value.replace(/[^a-z0-9]/gi,"")+"@cliente.com";syncHidden(form);});
          if(inp.value){lead.name=inp.value;lead.email=inp.value.replace(/[^a-z0-9]/gi,"")+"@cliente.com";}
        }
        if(inp.name==="cpf"||inp.id==="cpf"){
          inp.addEventListener("input",function(){lead.cpf=inp.value;syncHidden(form);});
          inp.addEventListener("blur",function(){lead.cpf=inp.value;syncHidden(form);});
          if(inp.value)lead.cpf=inp.value;
        }
      });
      syncHidden(form);
    });
    function syncHidden(form){
      setHidden(form,"utm_phone","phone",lead.phone);
      setHidden(form,"utm_name","name",lead.name);
      setHidden(form,"utm_email","email",lead.email);
    }
    function setHidden(form,hid,hname,val){
      var el=document.getElementById(hid);
      if(!el){el=document.createElement("input");el.type="hidden";el.id=hid;el.name=hname;form.appendChild(el);}
      el.value=val||"";
    }
    obs.observe(document.body||document.documentElement,{childList:true,subtree:true});
  })();
  </script>

