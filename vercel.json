{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/repasse/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/repasse/(.*)",
      "destination": "/repasse/$1"
    },
    {
      "source": "/repasse",
      "destination": "/repasse/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
